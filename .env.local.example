# Example .env.local for Next.js (do NOT commit secrets)

# Telegram
TELEGRAM_BOT_TOKEN=seu_bot_token
TELEGRAM_CHAT_ID=seu_chat_id

# Optionally, Spring-style keys (used as fallbacks by the API route)
# telegram.bot.token=seutokenaqui
# telegram.chat.id=suaidchatid

# API Backend (Spring Boot) - aponte para sua LXC local/proxmox
NEXT_PUBLIC_API_BASE_URL=http://192.168.0.70:8080
# opcional: separar host/port para next.config remotePatterns
NEXT_PUBLIC_API_HOST=192.168.0.70
NEXT_PUBLIC_API_PORT=8080
